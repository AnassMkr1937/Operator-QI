# ==============================================
# OPERATOR IQ — Environment Variables
# Copy this file to .env and fill in the values
# ==============================================

# Application
APP_NAME="Operator IQ"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://operatoriq:operatoriq@localhost:5432/operatoriq

# Security — CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-minimum-32-chars-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business rules
SKILL_DECAY_HALF_LIFE_DAYS=90
MIN_COMPETENCY_THRESHOLD=70.0
MAX_REPLACEMENT_CANDIDATES=10

# Audit
AUDIT_LOG_ENABLED=true

# Frontend
VITE_API_URL=http://localhost:8000
